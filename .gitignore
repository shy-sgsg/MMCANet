# ====================================
# 2. Python 与 深度学习 (PyTorch/Diffusion)
# ====================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# 权重文件与数据集 (建议将大文件放在专门目录并排除)
*.pth
*.pt
*.ckpt
*.onnx
*.weights
*.h5
# 如果有专门存放模型或数据的文件夹，取消下面两行的注释
checkpoints/
data/
outputs/
weights/

# ====================================
# 3. MATLAB 仿真
# ====================================
*.asv
*.m~
*.mex*
*.slxc
*.mat
!/data/*.mat  # 如果某些 .mat 是必要的测试数据，可以用 ! 排除过滤

# ====================================
